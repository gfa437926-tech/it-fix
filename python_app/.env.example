# Local native PostgreSQL (no Docker). Create this database and user first.
# This is PostgreSQL-compatible storage; it is not the full Supabase local stack.
DATABASE_URL=postgresql+psycopg://itfix_app:CHANGE_ME@127.0.0.1:5432/itfix_assets
AUTO_CREATE_SCHEMA=false

# For an offline first run, leave DATABASE_URL unset and the app uses SQLite.
# For a hosted Supabase Postgres connection, use the project's direct database
# connection string and keep sslmode=require. Never commit real credentials.
