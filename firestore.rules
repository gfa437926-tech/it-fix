rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function controllerExists() {
      return exists(/databases/$(database)/documents/system_settings/controller);
    }

    function isPrimaryController() {
      return signedIn() &&
        controllerExists() &&
        get(/databases/$(database)/documents/system_settings/controller).data.primaryUid == request.auth.uid;
    }

    function isSuperAdmin() {
      // Keep elevated account administration bound to the immutable controller UID.
      // A profile role alone must never grant privilege to promote or disable users.
      return isPrimaryController() ||
        (signedIn() && request.auth.token.email == 'gfa437926@gmail.com');
    }

    function isActiveUser() {
      return isSuperAdmin() || (userExists() && userDoc().isActive == true);
    }

    function isAdmin() {
      return isSuperAdmin() || (isActiveUser() && userDoc().role in ['admin', 'it_manager']);
    }

    // Health check endpoint for testing initial connection
    match /test/connection {
      allow read: if true;
    }

    // User profiles & RBAC
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A new account may create only its own limited profile. The first
      // controller is elevated only after the controller bootstrap document
      // has been created successfully for this same authenticated UID.
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.isActive == true &&
        (
          request.resource.data.role == 'it_manager' ||
          (isPrimaryController() && request.resource.data.role == 'admin') ||
          (request.auth.token.email == 'gfa437926@gmail.com' && request.resource.data.role == 'admin')
        );

      // Users can edit basic profile details only; role and activation state
      // are reserved for the super-admin path.
      allow update: if isSuperAdmin() ||
        (
          isActiveUser() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
        );
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // Offices & locations
    match /offices/{officeId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Assets inventory
    match /assets/{assetId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Unique serial number reservations
    match /asset_serials/{serialId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Custody assignments
    match /custody_cards/{cardId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Maintenance records and service history
    match /maintenance_records/{recordId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Spare parts catalog
    match /spare_parts/{partId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Maintenance parts consumption events
    match /maintenance_parts/{usageId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Procurement invoices and warranties
    match /purchase_records/{purchaseId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Movements and audits timeline
    match /asset_movements/{movementId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // System settings and controller configuration
    match /system_settings/{docId} {
      // Auth bootstrap and the app's settings listener run before the user profile loads.
      allow read: if signedIn();

      // Allow exactly one initial controller bootstrap. Subsequent edits to
      // controller identity and all other system settings require that UID.
      allow create: if docId == 'controller' &&
        signedIn() &&
        !controllerExists() &&
        request.resource.data.primaryUid == request.auth.uid &&
        request.resource.data.primaryEmail == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['primaryUid', 'primaryEmail', 'registeredAt']);

      allow update, delete: if docId == 'controller' && isPrimaryController();
      allow create, update, delete: if docId != 'controller' && isPrimaryController();
    }

    // Documents and attachment metadata
    match /asset_documents/{documentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Import batches audit
    match /import_batches/{batchId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Physical inventory checks are append-only records.
    match /inventory_checks/{checkId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // General audit logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
