rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function controllerExists() {
      return exists(/databases/$(database)/documents/system_settings/controller);
    }

    function isPrimaryController() {
      return signedIn() &&
        controllerExists() &&
        get(/databases/$(database)/documents/system_settings/controller).data.primaryUid == request.auth.uid;
    }

    function isSuperAdmin() {
      // Keep elevated account administration bound to the immutable controller UID.
      // A profile role alone must never grant privilege to promote or disable users.
      return isPrimaryController();
    }

    function isActiveUser() {
      return isSuperAdmin() || (userExists() && userDoc().isActive == true);
    }

    function isAdmin() {
      // Scoped IT managers must never inherit global admin access from their role.
      // The legacy fallback exists only for accounts not yet migrated by the controller.
      return isSuperAdmin() ||
        (
          isActiveUser() &&
          userDoc().role == 'it_manager' &&
          (!userDoc().keys().hasAny(['accessControlEnabled']) ||
            userDoc().accessControlEnabled != true)
        );
    }

    // Legacy IT managers remain compatible until the controller explicitly
    // enables scoped access for their profile. Once enabled, no implicit
    // access is granted: each operation needs a permission and an assigned scope.
    function isScopedAccessEnabled() {
      return isActiveUser() &&
        userDoc().keys().hasAny(['accessControlEnabled']) &&
        userDoc().accessControlEnabled == true;
    }

    function isLegacyItManager() {
      return isActiveUser() &&
        userDoc().role == 'it_manager' &&
        !isScopedAccessEnabled();
    }

    function hasPermission(permission) {
      return userDoc().keys().hasAny(['permissions']) &&
        userDoc().permissions is map &&
        userDoc().permissions.get(permission, false) == true;
    }

    function hasAssignedScope(officeId, warehouseId) {
      return (
        officeId is string &&
        officeId.size() > 0 &&
        userDoc().keys().hasAny(['officeIds']) &&
        userDoc().officeIds is list &&
        userDoc().officeIds.hasAny([officeId])
      ) || (
        warehouseId is string &&
        warehouseId.size() > 0 &&
        userDoc().keys().hasAny(['warehouseIds']) &&
        userDoc().warehouseIds is list &&
        userDoc().warehouseIds.hasAny([warehouseId])
      );
    }

    function canAccessScopedResource(permission, officeId, warehouseId) {
      return isPrimaryController() ||
        isLegacyItManager() ||
        (
          isScopedAccessEnabled() &&
          hasPermission(permission) &&
          hasAssignedScope(officeId, warehouseId)
        );
    }

    // Health check endpoint for testing initial connection
    match /test/connection {
      allow read: if true;
    }

    // User profiles & RBAC
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A new account may create only its own limited profile. The first
      // controller is elevated only after the controller bootstrap document
      // has been created successfully for this same authenticated UID.
      allow create: if
        (
          // The primary controller may provision a profile for an existing
          // Firebase Auth UID supplied through the user-management screen.
          isSuperAdmin() &&
          request.resource.data.uid == uid &&
          request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isActive'])
        ) ||
        (
          // Self-registration is restricted to the least-privileged role.
          signedIn() &&
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.isActive == true &&
          request.resource.data.role == 'it_manager' &&
          request.resource.data.accessControlEnabled == true &&
          request.resource.data.officeIds == [] &&
          request.resource.data.warehouseIds == [] &&
          request.resource.data.permissions is map &&
          request.resource.data.permissions.keys().size() == 0
        );

      // Users can edit basic profile details only; role and activation state
      // are reserved for the super-admin path.
      allow update: if isSuperAdmin() ||
        (
          isActiveUser() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
        );
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // Offices & locations
    match /offices/{officeId} {
      allow read: if isPrimaryController() || isLegacyItManager() ||
        (isScopedAccessEnabled() && hasPermission('offices.read') &&
          ((resource.data.id is string && userDoc().officeIds is list && resource.data.id in userDoc().officeIds) ||
           (resource.data.warehouseId is string && userDoc().warehouseIds is list && resource.data.warehouseId in userDoc().warehouseIds)));
      allow create: if canAccessScopedResource('offices.manage', officeId, request.resource.data.warehouseId);
      allow update: if canAccessScopedResource('offices.manage', officeId, resource.data.warehouseId) &&
        canAccessScopedResource('offices.manage', officeId, request.resource.data.warehouseId);
      allow delete: if canAccessScopedResource('offices.manage', officeId, resource.data.warehouseId);
    }

    // Warehouse directory uses the same explicit permission and assignment model.
    match /warehouses/{warehouseId} {
      allow read: if isPrimaryController() || isLegacyItManager() ||
        (isScopedAccessEnabled() && hasPermission('warehouses.read') &&
          resource.data.id is string && userDoc().warehouseIds is list && resource.data.id in userDoc().warehouseIds);
      allow create, update, delete: if canAccessScopedResource('warehouses.manage', '', warehouseId);
    }

    // Assets inventory
    match /assets/{assetId} {
      allow read: if canAccessScopedResource('assets.read', resource.data.officeId, resource.data.warehouseId);
      allow create: if canAccessScopedResource('assets.create', request.resource.data.officeId, request.resource.data.warehouseId);
      allow update: if canAccessScopedResource('assets.update', resource.data.officeId, resource.data.warehouseId) &&
        canAccessScopedResource('assets.update', request.resource.data.officeId, request.resource.data.warehouseId);
      allow delete: if canAccessScopedResource('assets.delete', resource.data.officeId, resource.data.warehouseId);
    }

    // Unique serial number reservations
    match /asset_serials/{serialId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Custody assignments
    match /custody_cards/{cardId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Maintenance records and service history
    match /maintenance_records/{recordId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Spare parts catalog
    match /spare_parts/{partId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Maintenance parts consumption events
    match /maintenance_parts/{usageId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Procurement invoices and warranties
    match /purchase_records/{purchaseId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Movements and audits timeline
    match /asset_movements/{movementId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // System settings and controller configuration
    match /system_settings/{docId} {
      // Auth bootstrap and the app's settings listener run before the user profile loads.
      allow read: if signedIn();

      // Allow exactly one initial controller bootstrap. Subsequent edits to
      // controller identity and all other system settings require that UID.
      allow create: if docId == 'controller' &&
        signedIn() &&
        !controllerExists() &&
        request.resource.data.primaryUid == request.auth.uid &&
        request.resource.data.primaryEmail == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['primaryUid', 'primaryEmail', 'registeredAt']);

      allow update, delete: if docId == 'controller' && isPrimaryController();
      allow create, update, delete: if docId != 'controller' && isPrimaryController();
    }

    // Documents and attachment metadata
    match /asset_documents/{documentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Import batches audit
    match /import_batches/{batchId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Physical inventory checks are append-only records.
    match /inventory_checks/{checkId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // General audit logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
